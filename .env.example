# Groq (backend only — never expose to the frontend)
GROQ_API_KEY=
PRIMARY_MODEL=openai/gpt-oss-120b
FAST_MODEL=openai/gpt-oss-20b
REASONING_MODEL=openai/gpt-oss-120b
COMPARISON_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. Never put this in frontend env files.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase PostgreSQL (SQLAlchemy)
DATABASE_URL=

# Application
DEMO_MODE=true
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# Workflow retry bounds (workflow rules, not agent decisions)
SECURITY_MAX_RETRIES=2
QA_MAX_RETRIES=2
REVIEW_MAX_RETRIES=2

# Execution safety
CODE_EXECUTION_TIMEOUT_SECONDS=15

# Storage
SUPABASE_STORAGE_BUCKET=sdlc-artifacts
