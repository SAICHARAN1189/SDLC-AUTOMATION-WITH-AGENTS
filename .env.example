# LLM Providers (backend only — never expose to frontend)
LLM_PROVIDER=gemini
ENABLE_LLM_FALLBACK=false

# Google Gemini (Primary Provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq (Secondary / Model Lab Provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

PRIMARY_MODEL=gemini-3.8-flash
FAST_MODEL=gemini-3.8-flash
REASONING_MODEL=gemini-3.8-flash
COMPARISON_MODELS=gemini-3.8-flash,openai/gpt-oss-120b,openai/gpt-oss-20b,groq/compound,groq/compound-mini

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. Never put this in frontend env files.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase PostgreSQL (SQLAlchemy - Persistent Storage for SDLC Nexus)
# Transaction pooler (recommended for serverless/pooled workloads, port 6543):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct / Session connection (port 5432):
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

# Application
DEMO_MODE=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# Workflow retry bounds (workflow rules, not agent decisions)
SECURITY_MAX_RETRIES=2
QA_MAX_RETRIES=2
REVIEW_MAX_RETRIES=2

# Execution safety
CODE_EXECUTION_TIMEOUT_SECONDS=15

# Storage
SUPABASE_STORAGE_BUCKET=sdlc-artifacts
