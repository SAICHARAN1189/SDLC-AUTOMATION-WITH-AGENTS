# Groq (backend only — never expose to the frontend)
GROQ_API_KEY=
PRIMARY_MODEL=llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant
REASONING_MODEL=llama-3.3-70b-versatile
COMPARISON_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,mixtral-8x7b-32768

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. Never put this in frontend env files.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase PostgreSQL (SQLAlchemy)
DATABASE_URL=

# Application
DEMO_MODE=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# Workflow retry bounds (workflow rules, not agent decisions)
SECURITY_MAX_RETRIES=2
QA_MAX_RETRIES=2
REVIEW_MAX_RETRIES=2

# Execution safety
CODE_EXECUTION_TIMEOUT_SECONDS=15

# Storage
SUPABASE_STORAGE_BUCKET=sdlc-artifacts
